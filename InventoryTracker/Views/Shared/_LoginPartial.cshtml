@using Microsoft.AspNetCore.Identity
@using InventoryTracker.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
        @if (User.IsInRole(nameof(UserRole.Manufacturer)))
        {
            <li class="nav-item">
                <p class="fw-bolder" style="color: indianred; margin-top: 9px; margin-right: 10px">Manufacturer</p>
            </li>
        }
        else if (User.IsInRole(nameof(UserRole.Wholesaler)))
        {
            <li class="nav-item">
                <p class="fw-bolder" style="color: paleturquoise; margin-top: 9px; margin-right: 10px">Wholesaler</p>
            </li>
        }
        else if (User.IsInRole(nameof(UserRole.Admin)))
        {
            <li class="nav-item">
                <p class="fw-bolder" style="color: lawngreen; margin-top: 9px; margin-right: 10px">Admin</p>
            </li>
        }

    <li class="nav-item">
        <form class="form-inline"
              method="post"
              asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Content("~/")">
            <button type="submit" class="nav-link btn btn-link text-light">Logout</button>
        </form>
    </li>

    <li class="nav-item">
        <a class="nav-link text-light" asp-area="" asp-controller="Profile" asp-action="Index">My Profile</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
