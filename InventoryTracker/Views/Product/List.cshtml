@model List<InventoryTracker.Models.Product>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Products</h2>
    <a asp-controller="Product" asp-action="Add" class="btn btn-success" style="background-color: #0f5132; border-color: #0f5132;">
        Add Product
    </a>
</div>

@if (Model.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Manufacturer</th>
                <th>Price</th>
                <th>Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.UserAccount?.AccountName</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.StockQuantity</td>
                    <td>
                        <a asp-controller="Product" asp-action="Index" asp-route-id="@product.ProductId">
                            View Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
