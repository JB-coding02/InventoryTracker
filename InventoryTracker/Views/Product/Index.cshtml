@model InventoryTracker.Models.Product

@{
    Layout = "_Layout";
}

<div class="container mt-4">
    @if (Model == null)
    {
        <div class="alert alert-warning">Product not found.</div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h2 class="mb-0">Product Details</h2>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Price</dt>
                    <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                    <dt class="col-sm-3">Stock Quantity</dt>
                    <dd class="col-sm-9">@Model.StockQuantity</dd>

                    <dt class="col-sm-3">Manufacturer</dt>
                    <dd class="col-sm-9">@(Model.UserAccount?.AccountName ?? "Unknown")</dd>
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <a asp-controller="Product" asp-action="@ViewBag.BackToListAction" class="btn btn-secondary">Back to List</a>
                    
                    @if (ViewBag.CanEditOrDelete == true)
                    {
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-primary">Edit</a>
                        
                        <form asp-controller="Product" asp-action="Delete" asp-route-id="@Model.ProductId" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" class="d-inline">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
