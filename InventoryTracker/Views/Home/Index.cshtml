@{
    ViewData["Title"] = "Home Page";
}

<div class="it-hero text-center">
    <h1>Inventory Tracker</h1>
    <p class="mb-4">A streamlined platform for manufacturers and wholesalers to manage products and orders.</p>
    <div class="d-flex gap-3 justify-content-center">
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light btn-lg px-4">Login</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg px-4">Register</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card it-card h-100">
            <div class="card-body">
                <h5 class="card-title">Browse Products</h5>
                <p class="card-text">View all available products from registered manufacturers.</p>
                <a asp-controller="Product" asp-action="List" class="btn btn-outline-primary btn-sm">View Products</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card it-card h-100">
            <div class="card-body">
                <h5 class="card-title">Manufacturers</h5>
                <p class="card-text">Register as a manufacturer to list and manage your products.</p>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-sm">Get Started</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card it-card h-100">
            <div class="card-body">
                <h5 class="card-title">Wholesalers</h5>
                <p class="card-text">Register as a wholesaler to browse and order products.</p>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary btn-sm">Get Started</a>
            </div>
        </div>
    </div>
</div>